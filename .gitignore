# Combobul — the vendored engine is not tracked, but the spec store IS.
# The spec graph's source of truth is combobul/spec/{mutations,snapshots}; spec.db
# is only a rebuildable cache. associations/ joins them: artifact associations are
# stored ONLY in that XML (ril.mjs loadAssociations reads it at query time, they are
# not in the mutation log), so leaving it ignored meant every implements/enforces
# link in the project existed on one machine and vanished on clone. Ignoring the whole tree left the know_kernel spec
# materialised nowhere but that cache: `ril journal coalesce` writes a .cbm here and
# then runs `git add` on it, which failed silently against the old `combobul/` rule,
# so the journal was never cleared and a single `ril rebuild` dropped all 103 KK
# nodes on 2026-09-15. These negations keep the spec reproducible from a clone.
combobul/*
!combobul/spec/
combobul/spec/*
!combobul/spec/mutations/
!combobul/spec/snapshots/
!combobul/spec/associations/
.combobul/

# Claude Code — runtime state (gitignored)
.claude/settings.local.json

# Node
node_modules/
package-lock.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Downloaded research PDFs (large binaries, re-downloadable)
data/pdfs/*.pdf

# Runtime databases (generated, not source)
# data/auth.db is tracked deliberately so a clone carries the accounts. It
# holds pbkdf2 password hashes and live session tokens; revisit this before
# the repository has any untrusted reader.
data/auth.db-wal
data/auth.db-shm
*.db-journal
*.db-wal
*.db-shm

# Environment
.env
.env.local

# OS
Thumbs.db
.DS_Store

# Test / coverage
htmlcov/
.coverage
.pytest_cache/

